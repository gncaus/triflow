# Backend (server/index.js). Named API_PORT (not PORT) on purpose: many dev
# tools / hosts already export a PORT env var for the frontend process, and
# since dotenv never overrides an existing env var, "PORT" here would silently
# collide with that instead of setting the backend's own port.
API_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Origin allowed to call the API with credentials in dev/split deployments.
# Not needed when frontend and backend are served by the same process.
CLIENT_ORIGIN=http://localhost:5173
